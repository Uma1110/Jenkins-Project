
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'GitHub repository connected!'
            }
        }

        stage('Build') {
            steps {
                echo 'Application is building...'
            }
        }

        stage('Test') {
            steps {
                echo 'All tests passed!'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Application deployed successfully!'
            }
        }
    }
}
